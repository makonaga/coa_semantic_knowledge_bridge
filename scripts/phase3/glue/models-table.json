{
  "Name": "models",
  "Description": "電子レンジの機種マスタ(検証用合成データ)。変化点管理票の対象機種一覧。",
  "TableType": "EXTERNAL_TABLE",
  "Parameters": {
    "classification": "csv",
    "skip.header.line.count": "1"
  },
  "StorageDescriptor": {
    "Columns": [
      {"Name": "model_name", "Type": "string", "Comment": "機種名(電子レンジのモデル型番、主キー)"},
      {"Name": "series_name", "Type": "string", "Comment": "シリーズ名(ビストロ、エレック等。単機能レンジは空欄)"},
      {"Name": "product_category", "Type": "string", "Comment": "製品カテゴリ(スチームオーブンレンジ/オーブンレンジ/単機能レンジ)"},
      {"Name": "launch_year", "Type": "string", "Comment": "発売年"}
    ],
    "Location": "s3://coa-testdata-290918126236/glue/models/",
    "InputFormat": "org.apache.hadoop.mapred.TextInputFormat",
    "OutputFormat": "org.apache.hadoop.hive.ql.io.HiveIgnoreKeyTextOutputFormat",
    "SerdeInfo": {
      "SerializationLibrary": "org.apache.hadoop.hive.serde2.OpenCSVSerde",
      "Parameters": {
        "separatorChar": ",",
        "quoteChar": "\""
      }
    }
  }
}
